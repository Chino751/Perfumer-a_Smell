{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/cookies.php", "destination": "/cookies", "permanent": true },
    { "source": "/privacidad.php", "destination": "/privacidad", "permanent": true },
    { "source": "/reclamos.php", "destination": "/reclamos", "permanent": true },
    { "source": "/terminos-de-compra.php", "destination": "/terminos-de-compra", "permanent": true },
    { "source": "/terminos-y-condiciones.php", "destination": "/terminos-y-condiciones", "permanent": true },
    { "source": "/install.php", "destination": "/admin/login", "permanent": true },
    { "source": "/admin/login.php", "destination": "/admin/login", "permanent": true },
    { "source": "/admin/index.php", "destination": "/admin", "permanent": true },
    { "source": "/admin/perfumes.php", "destination": "/admin", "permanent": true },
    { "source": "/admin/combos.php", "destination": "/admin", "permanent": true },
    { "source": "/admin/settings.php", "destination": "/admin", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://atevowxmcunpujnbvfeg.supabase.co; connect-src 'self' https://atevowxmcunpujnbvfeg.supabase.co; font-src 'self'; manifest-src 'self'; worker-src 'none'; upgrade-insecure-requests" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
