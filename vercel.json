{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/cookies.php", "destination": "/cookies", "permanent": true },
    { "source": "/privacidad.php", "destination": "/privacidad", "permanent": true },
    { "source": "/reclamos.php", "destination": "/reclamos", "permanent": true },
    { "source": "/terminos-de-compra.php", "destination": "/terminos-de-compra", "permanent": true },
    { "source": "/terminos-y-condiciones.php", "destination": "/terminos-y-condiciones", "permanent": true },
    { "source": "/admin/login.php", "destination": "/admin/login", "permanent": true },
    { "source": "/admin/index.php", "destination": "/admin", "permanent": true },
    { "source": "/admin/perfumes.php", "destination": "/admin/perfumes", "permanent": true },
    { "source": "/admin/combos.php", "destination": "/admin/combos", "permanent": true },
    { "source": "/admin/settings.php", "destination": "/admin/settings", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
